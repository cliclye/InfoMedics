# Copy to .env and fill in. Everything here is optional.

# Enables AI verdicts. Without it, Infomedics runs in evidence-only mode.
ANTHROPIC_API_KEY=

# Model used for judging (default: claude-haiku-5-5, fast and cheap) and its effort level (default: low).
# INFOMEDICS_MODEL=claude-haiku-5-5
# INFOMEDICS_EFFORT=low

# Raises the PubMed rate limit from 3 to 10 requests/second (free at ncbi.nlm.nih.gov/account).
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com

# Pauses AI verdicts for the rest of the day (UTC) after this many tokens. Default 2000000; 0 = no limit.
# INFOMEDICS_DAILY_TOKEN_BUDGET=2000000

# PORT=3000
# HOST=127.0.0.1
