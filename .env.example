# Copy to .env and fill in. Everything here is optional.

# Enables AI verdicts. Without it, Infomedics runs in evidence-only mode.
ANTHROPIC_API_KEY=

# Model used for judging (default: claude-opus-5-5).
# INFOMEDICS_MODEL=claude-opus-5-5

# Raises the PubMed rate limit from 3 to 10 requests/second (free at ncbi.nlm.nih.gov/account).
# NCBI_API_KEY=
# NCBI_EMAIL=you@example.com

# PORT=3000
# HOST=127.0.0.1
