{
  "manifest_version": 3,
  "name": "Infomedics: Check health claims",
  "version": "0.1.0",
  "description": "Select a health claim on any page and see whether it holds up. Prototype: results are simulated.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Infomedics",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["data.js", "render.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
